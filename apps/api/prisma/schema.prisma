generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserRole {
  STUDENT
  TUTOR
  TRANSLATOR
  INTERPRETER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DEACTIVATED
}

enum ProfessionalApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  BUSY
}

enum CourseStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum CourseLevel {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
  PROFICIENT
}

enum LessonType {
  VIDEO
  AUDIO
  TEXT
  DOCUMENT
  QUIZ
  ASSIGNMENT
  LIVE_CLASS
}

enum MaterialType {
  VIDEO
  AUDIO
  PDF
  DOCUMENT
  PRESENTATION
  IMAGE
  OTHER
}

enum FileVisibility {
  PRIVATE
  COURSE_ENROLLED
  PUBLIC
}

enum FileStatus {
  PENDING
  READY
  QUARANTINED
  DELETED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  REFUNDED
}

enum CertificateStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  OTHER
}

enum PaymentItemType {
  COURSE
  CERTIFICATION
  TRANSLATION
  INTERPRETATION
  OTHER
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum TranslationServiceType {
  GENERAL_DOCUMENT
  CERTIFIED
  LEGAL
  ACADEMIC
  BUSINESS
  TECHNICAL
  WEBSITE
  OTHER
}

enum TranslationStatus {
  REQUESTED
  QUOTE_PENDING
  PAYMENT_PENDING
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  QUALITY_REVIEW
  REVISION_REQUIRED
  COMPLETED
  CANCELLED
}

enum TranslationFileDirection {
  SOURCE
  DELIVERABLE
  SUPPORTING
}

enum InterpretationBookingStatus {
  REQUESTED
  QUOTED
  PAYMENT_PENDING
  CONFIRMED
  INTERPRETER_ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
  REFUNDED
}

enum InterpretationLocationType {
  ONLINE
  CUSTOMER_LOCATION
  VENUE
}

enum ReviewTargetType {
  COURSE
  TUTOR
  TRANSLATOR
  INTERPRETER
  TRANSLATION
  INTERPRETATION
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

enum NotificationType {
  SYSTEM
  COURSE
  PAYMENT
  CERTIFICATE
  TRANSLATION
  INTERPRETATION
}

model User {
  id                     String                    @id @default(uuid())
  email                  String                    @unique
  passwordHash           String?
  roles                  UserRole[]                @default([STUDENT])
  status                 UserStatus                @default(PENDING)
  emailVerifiedAt        DateTime?
  lastLoginAt            DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  profile                Profile?
  tutorProfile           TutorProfile?
  translatorProfile      TranslatorProfile?
  interpreterProfile     InterpreterProfile?
  ownedFiles             File[]                    @relation("FileOwner")
  taughtCourses          Course[]                  @relation("CourseTutor")
  enrollments            Enrollment[]              @relation("EnrollmentStudent")
  lessonProgress         LessonProgress[]
  courseProgress         CourseProgress[]
  certificates           Certificate[]             @relation("CertificateStudent")
  payments               Payment[]
  payouts                Payout[]                  @relation("PayoutBeneficiary")
  translationRequests    TranslationRequest[]      @relation("TranslationCustomer")
  translationAssignments TranslationAssignment[]   @relation("TranslationAssignee")
  customerBookings       InterpretationBooking[]   @relation("InterpretationCustomer")
  interpreterBookings    InterpretationBooking[]   @relation("InterpretationAssignee")
  quizAttempts           QuizAttempt[]
  examAttempts           ExamAttempt[]
  reviews                Review[]
  notifications          Notification[]
  sentMessages           Message[]                 @relation("MessageSender")
  auditLogs              AuditLog[]                @relation("AuditActor")

  @@index([status])
}

model Profile {
  id           String   @id @default(uuid())
  userId       String   @unique
  firstName    String
  lastName     String
  displayName  String?
  phone        String?
  avatarFileId String?
  countryCode  String?
  timezone     String?
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarFile   File?    @relation("ProfileAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
}

model TutorProfile {
  id                  String                     @id @default(uuid())
  userId              String                     @unique
  approvalStatus      ProfessionalApprovalStatus @default(PENDING_APPROVAL)
  headline            String?
  biography           String?
  qualifications      String?
  yearsExperience     Int?
  languages           Json
  payoutAccountStatus String                     @default("PENDING")
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TranslatorProfile {
  id                 String                     @id @default(uuid())
  userId             String                     @unique
  approvalStatus     ProfessionalApprovalStatus @default(PENDING_APPROVAL)
  languagePairs      Json
  specializations    Json
  qualifications     String?
  yearsExperience    Int?
  availabilityStatus AvailabilityStatus         @default(AVAILABLE)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InterpreterProfile {
  id                 String                     @id @default(uuid())
  userId             String                     @unique
  approvalStatus     ProfessionalApprovalStatus @default(PENDING_APPROVAL)
  languagePairs      Json
  specializations    Json
  qualifications     String?
  yearsExperience    Int?
  availabilityStatus AvailabilityStatus         @default(AVAILABLE)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  user               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  courses     Course[]
}

model Course {
  id                       String       @id @default(uuid())
  tutorId                  String
  categoryId               String
  title                    String
  slug                     String       @unique
  shortDescription         String
  description              String
  level                    CourseLevel
  priceMinor               BigInt       @default(0)
  currency                 String       @default("NGN")
  status                   CourseStatus @default(DRAFT)
  thumbnailFileId          String?
  legacyLanguage           String       @map("language")
  legacyThumbnail          String?      @map("thumbnail")
  estimatedDurationMinutes Int?
  certificateEnabled       Boolean      @default(false)
  submittedAt              DateTime?
  publishedAt              DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  tutor                    User         @relation("CourseTutor", fields: [tutorId], references: [id], onDelete: Restrict)
  category                 Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  thumbnailFile            File?        @relation("CourseThumbnail", fields: [thumbnailFileId], references: [id], onDelete: SetNull)
  modules                  CourseModule[]
  enrollments              Enrollment[]
  courseProgress           CourseProgress[]
  certificates             Certificate[]
  exams                    Exam[]

  @@index([tutorId, status])
  @@index([categoryId, status])
  @@index([status, publishedAt])
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@unique([courseId, sortOrder])
  @@index([courseId, sortOrder])
}

model Lesson {
  id              String       @id @default(uuid())
  moduleId        String
  title           String
  description     String?
  lessonType      LessonType   @default(TEXT)
  sortOrder       Int          @default(0)
  isPreview       Boolean      @default(false)
  durationMinutes Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  module          CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  materials       LearningMaterial[]
  quiz            Quiz?
  progress        LessonProgress[]

  @@unique([moduleId, sortOrder])
  @@index([moduleId, sortOrder])
}

model File {
  id                 String         @id @default(uuid())
  ownerUserId        String?
  originalName       String
  objectKey          String         @unique
  mimeType           String
  sizeBytes          BigInt
  checksum           String?
  visibility         FileVisibility @default(PRIVATE)
  status             FileStatus     @default(PENDING)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  owner              User?          @relation("FileOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  avatarProfiles     Profile[]      @relation("ProfileAvatar")
  courseThumbnails   Course[]       @relation("CourseThumbnail")
  materials          LearningMaterial[]
  certificatePdfs    Certificate[]  @relation("CertificatePdf")
  translationFiles   TranslationFile[]
  messageAttachments Message[]      @relation("MessageAttachment")
}

model LearningMaterial {
  id            String       @id @default(uuid())
  lessonId      String
  fileId        String
  materialType  MaterialType
  downloadable  Boolean      @default(false)
  streamingOnly Boolean      @default(false)
  createdAt     DateTime     @default(now())
  lesson        Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  file          File         @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([lessonId])
  @@index([fileId])
}

model Quiz {
  id             String    @id @default(uuid())
  lessonId       String    @unique
  title          String
  passPercentage Decimal   @db.Decimal(5, 2)
  maxAttempts    Int?
  isPublished    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions      QuizQuestion[]
  attempts       QuizAttempt[]
}

model QuizQuestion {
  id           String       @id @default(uuid())
  quizId        String
  questionText  String
  questionType  QuestionType
  points        Int          @default(1)
  sortOrder     Int          @default(0)
  quiz          Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options       QuizOption[]

  @@unique([quizId, sortOrder])
}

model QuizOption {
  id          String       @id @default(uuid())
  questionId  String
  optionText  String
  isCorrect   Boolean      @default(false)
  sortOrder   Int          @default(0)
  question    QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, sortOrder])
}

model QuizAttempt {
  id          String    @id @default(uuid())
  quizId       String
  studentId    String
  score        Decimal?  @db.Decimal(8, 2)
  percentage   Decimal?  @db.Decimal(5, 2)
  passed       Boolean?
  startedAt    DateTime  @default(now())
  submittedAt  DateTime?
  quiz         Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student      User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([quizId, studentId])
}

model Exam {
  id              String    @id @default(uuid())
  courseId        String
  title           String
  passPercentage  Decimal   @db.Decimal(5, 2)
  durationMinutes Int?
  maxAttempts     Int       @default(1)
  isPublished     Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions       ExamQuestion[]
  attempts        ExamAttempt[]
}

model ExamQuestion {
  id           String       @id @default(uuid())
  examId       String
  questionText String
  questionType QuestionType
  points       Int          @default(1)
  sortOrder    Int          @default(0)
  exam         Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, sortOrder])
}

model ExamAttempt {
  id          String    @id @default(uuid())
  examId      String
  studentId   String
  score       Decimal?  @db.Decimal(8, 2)
  percentage  Decimal?  @db.Decimal(5, 2)
  passed      Boolean?
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([examId, studentId])
}

model Enrollment {
  id          String           @id @default(uuid())
  studentId   String           @map("userId")
  courseId    String
  paymentId   String?
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  student     User             @relation("EnrollmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payment     Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  progress    LessonProgress[]

  @@unique([studentId, courseId])
  @@index([studentId, status])
  @@index([courseId, status])
}

model LessonProgress {
  id                  String      @id @default(uuid())
  enrollmentId        String
  lessonId            String
  studentId           String
  progressPercentage  Decimal     @default(0) @db.Decimal(5, 2)
  lastPositionSeconds Int?
  completedAt         DateTime?
  updatedAt           DateTime    @updatedAt
  enrollment          Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson              Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student             User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([studentId, lessonId])
}

model CourseProgress {
  id                 String    @id @default(uuid())
  studentId          String
  courseId           String
  progressPercentage Decimal   @default(0) @db.Decimal(5, 2)
  completedAt        DateTime?
  updatedAt          DateTime  @updatedAt
  student            User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course             Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
}

model Certificate {
  id                String            @id @default(uuid())
  studentId         String
  courseId          String
  certificateNumber String            @unique
  verificationCode  String            @unique
  issuedAt          DateTime          @default(now())
  status            CertificateStatus @default(ACTIVE)
  pdfFileId         String?
  createdAt         DateTime          @default(now())
  student           User              @relation("CertificateStudent", fields: [studentId], references: [id], onDelete: Restrict)
  course            Course            @relation(fields: [courseId], references: [id], onDelete: Restrict)
  pdfFile           File?             @relation("CertificatePdf", fields: [pdfFileId], references: [id], onDelete: SetNull)
  verifications     CertificateVerification[]

  @@index([studentId])
  @@index([courseId])
}

model CertificateVerification {
  id               String      @id @default(uuid())
  certificateId    String
  verificationCode String      @unique
  verifiedAt       DateTime?
  lastCheckedAt    DateTime?
  certificate      Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String          @id @default(uuid())
  userId            String
  provider          PaymentProvider
  providerReference String          @unique
  amountMinor       BigInt
  currency          String
  status            PaymentStatus   @default(PENDING)
  paidAt            DateTime?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  items             PaymentItem[]
  refunds           Refund[]
  enrollments       Enrollment[]

  @@index([userId, status])
  @@index([status, createdAt])
}

model PaymentItem {
  id          String          @id @default(uuid())
  paymentId   String
  itemType    PaymentItemType
  referenceId String
  description String
  amountMinor BigInt
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
}

model Refund {
  id                String       @id @default(uuid())
  paymentId         String
  amountMinor       BigInt
  reason            String
  providerReference String?
  status            RefundStatus @default(PENDING)
  createdAt         DateTime     @default(now())
  payment           Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

model Payout {
  id                String       @id @default(uuid())
  beneficiaryUserId String
  amountMinor       BigInt
  currency          String
  status            PayoutStatus @default(PENDING)
  providerReference String?
  processedAt       DateTime?
  createdAt         DateTime     @default(now())
  beneficiary       User         @relation("PayoutBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: Restrict)
}

model TranslationRequest {
  id                String                 @id @default(uuid())
  customerId        String
  sourceLanguage    String
  targetLanguage    String
  serviceType       TranslationServiceType
  documentType      String?
  wordCount         Int?
  pageCount         Int?
  deadlineAt        DateTime?
  instructions      String?
  quotedAmountMinor BigInt?
  currency          String?
  status            TranslationStatus      @default(REQUESTED)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  customer          User                   @relation("TranslationCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  files             TranslationFile[]
  assignments       TranslationAssignment[]

  @@index([customerId, status])
  @@index([status, createdAt])
}

model TranslationFile {
  id        String                   @id @default(uuid())
  requestId String
  fileId    String
  direction TranslationFileDirection
  createdAt DateTime                 @default(now())
  request   TranslationRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  file      File                     @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([requestId, direction])
}

model TranslationAssignment {
  id           String             @id @default(uuid())
  requestId    String
  translatorId String
  assignedAt   DateTime           @default(now())
  acceptedAt   DateTime?
  submittedAt  DateTime?
  notes        String?
  request      TranslationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  translator   User               @relation("TranslationAssignee", fields: [translatorId], references: [id], onDelete: Restrict)

  @@unique([requestId, translatorId])
  @@index([translatorId, assignedAt])
}

model InterpretationService {
  id             String   @id @default(uuid())
  name           String
  description    String?
  basePriceMinor BigInt?
  currency       String?
  durationUnit   String
  isActive       Boolean  @default(true)
  bookings       InterpretationBooking[]
}

model InterpretationBooking {
  id                String                      @id @default(uuid())
  customerId        String
  serviceId         String
  interpreterId     String?
  sourceLanguage    String
  targetLanguage    String
  scheduledStartAt  DateTime
  scheduledEndAt    DateTime
  customerTimezone  String?
  locationType      InterpretationLocationType
  locationDetails   String?
  meetingUrl        String?
  eventDetails      String?
  quotedAmountMinor BigInt?
  currency          String?
  status            InterpretationBookingStatus @default(REQUESTED)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  customer          User                        @relation("InterpretationCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  service           InterpretationService       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  interpreter       User?                       @relation("InterpretationAssignee", fields: [interpreterId], references: [id], onDelete: SetNull)

  @@index([customerId, status])
  @@index([interpreterId, scheduledStartAt])
  @@index([scheduledStartAt, status])
}

model Review {
  id           String       @id @default(uuid())
  authorUserId String
  targetType   ReviewTargetType
  targetId     String
  rating       Int
  comment      String?
  status       ReviewStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  author       User         @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId, status])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Conversation {
  id        String    @id @default(uuid())
  subject   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
}

model Message {
  id               String       @id @default(uuid())
  conversationId   String
  senderId         String
  body             String
  attachmentFileId String?
  createdAt        DateTime     @default(now())
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  attachmentFile   File?        @relation("MessageAttachment", fields: [attachmentFileId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

model AuditLog {
  id          String    @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  actor       User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}

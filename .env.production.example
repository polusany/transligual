# Copy to .env.production on the deployment host. Never commit the filled file.
POSTGRES_DB=transligual
POSTGRES_USER=transligual
POSTGRES_PASSWORD=replace-with-a-unique-strong-password
SITE_DOMAIN=your-domain.example

# Both URLs must use the same credentials and database. URL-encode special
# characters in the password. The hostname is the private Compose service name.
DATABASE_URL=postgresql://transligual:replace-with-a-unique-strong-password@postgres:5432/transligual?schema=public
DIRECT_DATABASE_URL=postgresql://transligual:replace-with-a-unique-strong-password@postgres:5432/transligual?schema=public

# Generate with: openssl rand -base64 48
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
APP_URL=https://your-domain.example
WEB_APP_URL=https://your-domain.example
API_PORT=4000
UPLOAD_DIR=/app/uploads

# Required for verification and password recovery email delivery.
RESEND_API_KEY=re_replace_with_live_resend_key
EMAIL_FROM="Transligual <accounts@your-domain.example>"

# Required for the public instant-translation tool. Keep this key on the API only.
GOOGLE_TRANSLATE_API_KEY=replace-with-a-server-side-google-cloud-translation-api-key

# Optional payment processing. Configure the matching live provider webhook.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=https://your-domain.example/payments/return

# Only for the initial administrator seed. Remove after the account is created.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=Platform
BOOTSTRAP_ADMIN_LAST_NAME=Administrator

{
  "name": "transligual",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @transligual/web --filter @transligual/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @transligual/api prisma:generate",
    "db:migrate": "pnpm --filter @transligual/api prisma:migrate",
    "db:seed": "pnpm --filter @transligual/api prisma:seed"
  }
}

# Copy to .env for Docker Compose; copy apps/api/.env.example to apps/api/.env for Prisma.
POSTGRES_DB=transligual
POSTGRES_USER=transligual
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql://transligual:change-me-locally@localhost:5432/transligual?schema=public
DIRECT_DATABASE_URL=postgresql://transligual:change-me-locally@localhost:5432/transligual?schema=public
AUTH_JWT_SECRET=replace-with-a-long-random-local-secret
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
